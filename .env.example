# Run pnpm setup to generate .env with random secrets.
DATABASE_URL=postgresql://relay:replace-me@127.0.0.1:55432/relay
POSTGRES_PASSWORD=replace-me
BETTER_AUTH_URL=http://localhost:3110
WEB_PORT=3110
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
DATA_DIR=./data
ASR_URL=http://127.0.0.1:8100
ASR_MODEL=nemo-parakeet-tdt-0.6b-v3
SMTP_HOST=127.0.0.1
CONTAINER_SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=Relay <hello@localhost>
ALLOW_SIGNUP=true
# Production: set both SMTP_HOST and CONTAINER_SMTP_HOST to your real SMTP server.
# Or send through Resend instead of SMTP (sign-in, password reset and view/comment emails):
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# MAIL_FROM=Relay <video@your-verified-domain.com>
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=true
# RELAY_DOMAIN=video.example.com
# WORKER_CONCURRENCY=2
# WORKER_MEMORY=4g
# ASR_MEMORY=4g
# Recording admission limits, snapshotted at creation (default: 32 GiB, 6 hours).
# RELAY_MAX_UPLOAD_BYTES=34359738368
# RELAY_MAX_DURATION_SECONDS=21600
